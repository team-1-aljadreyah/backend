# =============================================================================
# Al-Jadreyah Clinic Management System — Environment Configuration Template
# File: .env.example
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local environment:
#      cp .env.example .env
# 2. Update placeholder values with your specific configuration.
# 3. NEVER commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Runtime Settings
# -----------------------------------------------------------------------------
# Name of the service displayed in logs and OpenAPI docs
APP_NAME="Al-Jadreyah Clinic Management System"

# Environment: "development", "staging", "testing", or "production"
APP_ENV=development

# Enable FastAPI interactive debug mode (MUST be false in production)
APP_DEBUG=false

# Bind address and port for the Uvicorn web server
APP_HOST=0.0.0.0
APP_PORT=8000

# Canonical clinic operational timezone (IANA format)
APP_TIMEZONE=Asia/Baghdad

# Cryptographic secret key used for signing session tokens and internal payloads.
# REQUIRED: Must be at least 32 characters long in production (generate with `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars

# -----------------------------------------------------------------------------
# 2. Database Configuration (Async PostgreSQL / Supabase / SQLite)
# -----------------------------------------------------------------------------
# Async connection URL format for PostgreSQL:
# postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
#
# Examples:
# - Supabase Transaction Pooler (Port 6543):
#   postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# - Local Docker PostgreSQL (Port 5432):
#   postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aljadreyah_clinic
# - Local SQLite (Testing & offline prototyping only):
#   sqlite+aiosqlite:///./clinic.db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aljadreyah_clinic

# Enable SQLAlchemy query logging in stdout (true/false)
DB_ECHO=false

# Connection pool settings for PostgreSQL
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15

# -----------------------------------------------------------------------------
# 3. Supabase Auth, Storage & Realtime (Optional / Production Integration)
# -----------------------------------------------------------------------------
# Supabase API project endpoint
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous/publishable API key
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase service role secret key (keep strictly confidential!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Storage bucket name for private medical lab uploads & welfare documents
SUPABASE_STORAGE_BUCKET=lab-results

# Optional JWKS URL for Supabase JWT verification
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# 4. Security, JWT & Tokens
# -----------------------------------------------------------------------------
# Access token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token validity in days (default: 30 days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# JWT signing algorithm (HS256)
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend web URLs
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://alrahma.ama8.uk

# -----------------------------------------------------------------------------
# 6. Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 7. Payment Gateway Integration (Qi Card / Local Gateway)
# -----------------------------------------------------------------------------
# Gateway provider mode: "mock" (for sandbox/testing) or "qi" (production)
PAYMENT_PROVIDER_MODE=mock

# Gateway API authorization key (if applicable)
PAYMENT_GATEWAY_API_KEY=
