# =============================================================================
# Al-Jadreyah Clinic Management System — Git Attributes
# =============================================================================

# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files that must always use LF line endings
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.tar.gz binary
*.zip binary
